# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.

# --- restic ---

# THE most important value in this repo. Lose it and every snapshot is
# permanently unreadable — restic has no recovery path, by design. Store a copy
# in a password manager BEFORE the first backup runs.
# Generate one with: openssl rand -base64 32
RESTIC_PASSWORD=REPLACE_ME

# Where the local repository lives. Root-owned; the container writes it.
BACKUP_REPO_DIR=/mnt/data/restic-docker

# Name recorded on each snapshot (`restic snapshots` groups by it).
BACKUP_HOST=dalaran

# --- scheduling ---
# The container schedules itself with cron; there is no host timer to install.
# Standard five-field cron expression. Default: nightly at 03:30.
BACKUP_SCHEDULE=30 3 * * *

# Container clock, so BACKUP_SCHEDULE means local time rather than UTC.
TZ=America/Los_Angeles

# The container reports unhealthy once the last successful backup is this old.
# This is what catches "backups quietly stopped weeks ago".
STALE_AFTER_HOURS=48

# On startup, if the last success is older than this, back up immediately
# rather than waiting for the next scheduled slot. This is the equivalent of a
# systemd timer's Persistent=true, for a host that was powered off.
CATCHUP_AFTER_HOURS=26
CATCHUP_ON_START=true

# --- retention ---
# Snapshots kept after each run. Everything older is pruned.
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12

# Volumes to skip: space-separated globs matched on the volume name. These
# rebuild themselves, so storing them is pure waste. Anonymous volumes (64 hex
# characters) are always skipped.
#
# monitoring_*_data backup_state covers the observability stores — Prometheus metrics, Loki
# logs, Alloy's WAL, and Grafana's own database. None of it is worth restoring:
# the dashboards, datasources and alert rules are all provisioned from this
# repo (and so are captured via /config), Grafana's 53 MB is mostly
# re-downloadable plugins, and metrics history from before a disaster has
# little value afterwards. It deliberately does NOT match
# monitoring_tailscale_state, which is node identity worth keeping.
EXCLUDE_VOLUMES=jellyfin_cache *_caddy_data *_caddy_config monitoring_*_data backup_state

# --- optional: offsite copy ---
# Leave empty for local-only. To add Cloudflare R2, create a bucket and an API
# token with Object Read & Write, then:
#   RESTIC_REPOSITORY_OFFSITE=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#   AWS_ACCESS_KEY_ID=<r2 access key id>
#   AWS_SECRET_ACCESS_KEY=<r2 secret access key>
# The same RESTIC_PASSWORD encrypts both targets.
RESTIC_REPOSITORY_OFFSITE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- optional: failure alerts ---
# Same ntfy topic as the monitoring project. A backup that fails silently is
# the same as no backup, so this is worth setting.
NTFY_URL=
