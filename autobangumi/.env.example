# Copy to .env (gitignored) and fill in. .env is read by `docker compose`.

# --- Tailscale / Caddy front ---

# Tailscale auth key for this node. Non-ephemeral (survives restarts). Edit
# this file directly rather than pasting the key anywhere else.
#   Admin console > Settings > Keys > Generate auth key
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Node name on the tailnet -> <TS_HOSTNAME>.<TAILNET_NAME>.ts.net
TS_HOSTNAME=autobangumi

# Your tailnet name, shown at the top of Admin console > DNS.
TAILNET_NAME=your-tailnet

# Custom private domain for this service. Only resolves/reachable inside the
# tailnet. The dns-sync service creates the Cloudflare record for it.
CUSTOM_DOMAIN=autobangumi.example.com

# Cloudflare API token, Zone:DNS:Edit + Zone:Read for the domain's zone. Used
# for the ACME DNS-01 challenge and by dns-sync.
CF_API_TOKEN=REPLACE_ME

# --- AutoBangumi ---

# Image tag is pinned in compose.yaml and bumped there (via Renovate PRs).
# Uncomment to override.
#AUTOBANGUMI_VERSION=
