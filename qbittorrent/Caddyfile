{
	tailscale {
		auth_key {$TS_AUTHKEY}
		state_dir /var/lib/tailscale-caddy
	}
}

# Pass the browser's original Host through untouched (Caddy's default). On
# every request that carries an Origin/Referer — i.e. every CSS/JS/image/API
# request from the WebUI — qBittorrent 5.x compares that header's host against
# the Host header and returns 401 on a mismatch. Rewriting Host to the
# upstream's host:port makes all of those look cross-site, so only the initial
# refererless page load succeeds. qBittorrent's Host-header validation accepts
# any domain by default (WebUI\ServerDomains=*), so the real Host is fine.
(qbittorrent) {
	reverse_proxy qbittorrent:8080
}

{$TS_HOSTNAME}.{$TAILNET_NAME}.ts.net {
	bind tailscale/{$TS_HOSTNAME}
	tls {
		get_certificate tailscale
	}
	import qbittorrent
}

{$CUSTOM_DOMAIN} {
	bind tailscale/{$TS_HOSTNAME}
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	import qbittorrent
}
