# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.

# --- Tailscale / Caddy front ---

# A Tailscale auth key for this node (one per node). Non-ephemeral. Edit this
# file directly rather than pasting the key elsewhere.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Node name on the tailnet -> <TS_HOSTNAME>.<TAILNET_NAME>.ts.net
TS_HOSTNAME=qbittorrent

# Your tailnet name, shown at the top of Admin console > DNS.
TAILNET_NAME=your-tailnet

# Custom private domain. Only reachable inside the tailnet. The dns-sync
# service creates the Cloudflare record for it.
CUSTOM_DOMAIN=qbittorrent.example.com

# Cloudflare API token, Zone:DNS:Edit + Zone:Read for the domain's zone. Used
# for the ACME DNS-01 challenge and by dns-sync.
CF_API_TOKEN=REPLACE_ME

# --- qBittorrent ---

TZ=Etc/UTC

# User the container runs as. New downloads are written with this uid:gid.
PUID=1000
PGID=1000

# Supplementary group so qBittorrent can manage files under DOWNLOADS_DIR that
# other tools created (the gid that owns them: `stat -c %g <file>`).
MEDIA_GID=1000

# Host downloads directory, mounted read-write at the SAME path in the
# container so torrent save-paths are identical inside and out.
DOWNLOADS_DIR=/path/to/downloads

# BitTorrent listen port, published to the host.
BT_PORT=6881
