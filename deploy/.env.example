# Copy to .env (gitignored). Read by deploy.sh; all values are optional.

# ntfy topic URL for deploy results: a failure (high priority) or a summary of
# what was deployed (low priority). A plain topic URL, like backup/.env's —
# not monitoring's, which has a query string for Grafana's JSON payload.
NTFY_URL=

# Where to pull from. A remote name, or a URL. If origin uses SSH with a
# passphrase-protected key, the timer cannot unlock it; the repo is public,
# so pull over HTTPS instead:
#   DEPLOY_REMOTE=https://github.com/<owner>/<repo>.git
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=main

# Seconds to let containers start before checking their health.
SETTLE_SECONDS=90

# ISO weekday (1 = Monday ... 7 = Sunday) to rebuild local images with
# --pull. Empty disables the weekly rebuild.
REBUILD_WEEKDAY=7
