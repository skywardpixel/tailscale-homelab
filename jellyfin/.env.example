# Copy to .env (gitignored) and fill in. .env is read by `docker compose`.

# --- Tailscale / Caddy front ---

# A NEW Tailscale auth key for the jellyfin node (one key per node).
# Non-ephemeral. Edit this file directly rather than pasting the key elsewhere.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Node name on the tailnet -> <TS_HOSTNAME>.<TAILNET_NAME>.ts.net
TS_HOSTNAME=jellyfin

# Your tailnet name, shown at the top of Admin console > DNS.
TAILNET_NAME=your-tailnet

# Custom private domain. DNS-only (grey-cloud) A record -> node's Tailscale IPv4.
CUSTOM_DOMAIN=jellyfin.example.com

# Cloudflare API token, Zone:DNS:Edit for the domain's zone. Can be the same
# token used by other services if they share a zone.
CF_API_TOKEN=REPLACE_ME

# --- Jellyfin ---

# Image tag (https://hub.docker.com/r/jellyfin/jellyfin/tags).
JELLYFIN_VERSION=10.11.11

# Host path to your media. Bind-mounted read-only at the SAME path inside the
# container, so library paths stored in Jellyfin's database stay valid.
MEDIA_DIR=/path/to/media

# uid:gid the container runs as. When migrating from the Debian package, use
# that install's 'jellyfin' user (getent passwd jellyfin -> usually 103:105)
# so the migrated files and any absolute paths in the DB line up.
JELLYFIN_UID=103
JELLYFIN_GID=105

# Supplementary group id the container joins so it can read the media files
# (the gid that owns MEDIA_DIR's contents; `stat -c %g` on a media file).
MEDIA_GID=1000
