# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.

# --- Tailscale / Caddy front ---

# A Tailscale auth key for this node (one per node). Non-ephemeral. Edit this
# file directly rather than pasting the key elsewhere.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Node name on the tailnet -> <TS_HOSTNAME>.<TAILNET_NAME>.ts.net
TS_HOSTNAME=hermes

# Your tailnet name, shown at the top of Admin console > DNS.
TAILNET_NAME=your-tailnet

# Stable IPv4 of THIS service's Caddy node, from the Tailscale admin console.
# Not the Docker host's IP. Leave blank until Caddy first joins the tailnet.
# Fill it before starting dns-sync. Update it if the node is replaced.
TS_IPV4=

# Custom private domain. Only reachable inside the tailnet. The dns-sync
# service creates the Cloudflare record for it.
CUSTOM_DOMAIN=hermes.example.com

# Cloudflare API token, Zone:DNS:Edit + Zone:Read for the domain's zone. Used
# for the ACME DNS-01 challenge and by dns-sync.
CF_API_TOKEN=REPLACE_ME

# --- Hermes ---
TZ=America/Los_Angeles
HERMES_USERNAME=admin
# Set a unique password. Single-quote values containing $ or # in Compose .env.
HERMES_PASSWORD=
# Generate separately with: openssl rand -hex 32
HERMES_SESSION_SECRET=
# Generate a second value with: openssl rand -hex 32
HERMES_API_KEY=

# Model and optional chat-platform credentials are entered with `hermes setup`
# and stored in the data volume, rather than passed to the proxy containers.
