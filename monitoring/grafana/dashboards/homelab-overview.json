    "x": 0,
    "y": 24
   },
   "panels": []
  },
  {
   "type": "table",
   "id": 19,
   "title": "Drive health",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true,
     "expr": "smartctl_device_smart_status"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true,
     "expr": "smartctl_device_temperature{temperature_type=\"current\"}"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true,
     "expr": "smartctl_device_power_on_seconds / 3600"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true,
     "expr": "smartctl_device_attribute{attribute_name=\"Wear_Leveling_Count\",attribute_value_type=\"value\"}"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true,
     "expr": "sum by (device) (smartctl_device_attribute{attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable\",attribute_value_type=\"raw\"})"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "device",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "attribute_name": true,
       "attribute_value_type": true,
       "temperature_type": true
      },
      "renameByName": {
       "device": "Device",
       "Value #A": "SMART OK",
       "Value #B": "Temp \u00b0C",
       "Value #C": "Power-on hrs",
       "Value #D": "Wear (100\u21920)",
       "Value #E": "Bad sectors"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "SMART OK"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "FAIL",
            "color": "red"
           },
           "1": {
            "text": "pass",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Temp \u00b0C"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "yellow",
           "value": 50
          },
          {
           "color": "red",
           "value": 60
