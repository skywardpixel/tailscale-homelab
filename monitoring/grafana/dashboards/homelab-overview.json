  {
   "type": "timeseries",
   "id": 8,
   "title": "Load average",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 5
