# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.

# --- Tailscale / Caddy front ---

# A Tailscale auth key for this node (one per node). Non-ephemeral. Edit this
# file directly rather than pasting the key elsewhere.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Node name on the tailnet -> <TS_HOSTNAME>.<TAILNET_NAME>.ts.net
TS_HOSTNAME=grafana

# Your tailnet name, shown at the top of Admin console > DNS.
TAILNET_NAME=your-tailnet

# Stable IPv4 of THIS service's Caddy node, from the Tailscale admin console.
# Not the Docker host's IP. Update this if the node is replaced.
TS_IPV4=

# Custom private domain. Only reachable inside the tailnet. The dns-sync
# service creates the Cloudflare record for it.
CUSTOM_DOMAIN=grafana.example.com

# Cloudflare API token, Zone:DNS:Edit + Zone:Read for the domain's zone. Used
# for the ACME DNS-01 challenge and by dns-sync.
CF_API_TOKEN=REPLACE_ME

# --- Grafana ---

# Initial admin password (user: admin). Change it, or change it in the UI after
# first login.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# ntfy topic URL that alerts POST to. Use a long, unguessable topic — anyone
# with the URL can read your alerts (or publish fake ones). Self-hosted ntfy
# or https://ntfy.sh/<topic>.
NTFY_URL=https://ntfy.sh/REPLACE_ME_with_a_random_topic

# --- media-exporter (qBittorrent + Jellyfin application metrics) ---

# qBittorrent WebUI API. The default reaches it over the shared `downloads`
# network, where this repo's WebUI auth-subnet whitelist means no credentials
# are needed. Only set the username/password if your instance isn't whitelisted.
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Jellyfin API, over the shared `media` network. Unlike qBittorrent this does
# need a key: Jellyfin > Dashboard > Advanced > API Keys > "+", name it
# "media-exporter", paste the key here. Leave JELLYFIN_API_KEY empty and the
# exporter skips Jellyfin entirely — the qBittorrent half still works.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
