# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.
#
# Unlike the other projects there is no Tailscale/Caddy block here: animegakill
# has no web UI. Everything else lives in config.yaml, which IS committed —
# only secrets belong in this file.

TZ=America/Los_Angeles

# Must match DOWNLOADS_DIR in qbittorrent/.env. config.yaml builds the save
# path from it, and qBittorrent mounts that same path inside and out, so the
# two always agree.
DOWNLOADS_DIR=/path/to/downloads

# qBittorrent WebUI password. Leave EMPTY in the normal setup: this container
# is on the `downloads` network (172.28.0.0/16), which qBittorrent's WebUI
# auth-subnet whitelist bypasses, so no credentials are ever sent.
# Fill it in only if you remove that whitelist or move this service off the
# `downloads` network.
QB_PASS=

# Only needed for a Mikan "My Bangumi" aggregated feed, whose URL carries a
# personal token. Referenced as ${MIKAN_TOKEN} in config.yaml so the token
# stays out of git. Leave empty if you only use per-show feeds.
MIKAN_TOKEN=
