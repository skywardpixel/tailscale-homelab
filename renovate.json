{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "description": "qBittorrent (LinuxServer): track only the clean X.Y.Z app-version tag, not the 5.2.3_v2.0.14-lsNNN or -libtorrentv1 variants",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "AutoBangumi: SemVer, so beta tags are ignored",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/estrellaxd/auto_bangumi"],
      "versioning": "semver"
    },
    {
      "description": "Group the caddy base image bumps into one PR",
      "matchFileNames": ["_caddy-tailscale/Dockerfile"],
      "groupName": "caddy base image"
    }
  ]
}
